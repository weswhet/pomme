// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = pomme
PRODUCT_DISPLAY_NAME = pomme
PRODUCT_BUNDLE_IDENTIFIER = com.github.weswhet.pomme
OTHER_CODE_SIGN_FLAGS = --identifier $(PRODUCT_BUNDLE_IDENTIFIER)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 15.0
ARCHS = arm64
ALWAYS_SEARCH_USER_PATHS = NO
OTHER_LDFLAGS = $(inherited) -weak_framework AppKit -weak_framework Virtualization -weak_framework Vision

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/pomme.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/pomme.entitlements
